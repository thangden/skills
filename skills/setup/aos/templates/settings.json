{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/memory-stop.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/clean-state.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-format.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/janitor-surface.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/cold-start.sh"
          }
        ]
      }
    ]
  }
}
