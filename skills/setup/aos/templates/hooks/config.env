# aos hooks config — generated by /aos from interview answers + tech-stack detection.
# Sourced by verify-gate.sh (and the domain guards). Edit to tune per-repo.
# All values are plain strings. Empty value = that step is skipped.

# ─── Verify gate (ADR-0008) ────────────────────────────────────────────────
# Mode: block | warn | off
#   block — exit 2 on failure (blocks the Stop). Default for Tech repos.
#   warn  — print failure to stderr, do not block.
#   off   — skip entirely. Default for Non-Tech workspaces.
VERIFY_GATE_MODE="block"

# Layer 1 — static / compile (fast). e.g. tsc, go build, mypy.
COMPILE_CMD=""        # e.g. "npx tsc --noEmit"  |  "go build ./..."  |  "mypy ."
LINT_CMD=""           # e.g. "eslint ."          |  "go vet ./..."    |  "ruff check ."

# Layer 2 — unit / integration (medium). e.g. vitest, go test, pytest.
TEST_CMD=""           # e.g. "vitest run"        |  "go test ./..."   |  "pytest -q"

# Layer 3 — E2E / system (slow). Only runs on Stop when E2E_ON_STOP=1
# (usually leave 0 and run E2E in CI / manually; it is too slow per-turn).
E2E_CMD=""            # e.g. "playwright test"
E2E_ON_STOP="0"

# Soft per-layer time budget in seconds (advisory; not hard-killed — see ADR-0008).
VERIFY_TIMEOUT="120"

# ─── Auto-format (PostToolUse) ─────────────────────────────────────────────
# Runs on each file right after Claude edits it. Empty = off. Examples:
#   Go: "gofmt -w"  |  Python: "ruff format"  |  TS/JS: "npx prettier --write"
FORMAT_CMD=""
FORMAT_PATHS=""   # optional glob filter, e.g. "*.go" (empty = format any edited file)

# ─── Domain guards (parameterize the franchise-portal-style hooks) ──────────
# These let the same hook script work across repos without hard-coding TS/RBAC.
PROTECTED_PATHS=""    # glob(s) needing a guard, e.g. "src/routes/_auth/**"
RBAC_MARKERS=""       # grep proving a guard exists, e.g. "beforeLoad|hasRole\\(|can\\("
RED_LINE_PATTERNS=""  # paths that must never reach main, e.g. "mock/|fixtures/stubs/"

# ─── Observability (ADR-0010, optional) ────────────────────────────────────
AUDIT_LOG="1"         # 1 = append JSONL to .claude/hooks-audit-YYYY-MM-DD.log
OTEL_ENABLED="0"      # 1 = emit OpenTelemetry GenAI spans for hook runs
OTEL_ENDPOINT=""      # OTLP/HTTP endpoint when OTEL_ENABLED=1
